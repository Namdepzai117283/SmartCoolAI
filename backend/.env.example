# ==========================================
# SmartCool AI Backend – copy file này thành .env rồi sửa giá trị
# ==========================================

# PostgreSQL
# - Máy cá nhân (Docker hoặc PostgreSQL cài trên Windows):
DATABASE_URL="postgresql://smartcool:smartcool@localhost:5432/smartcool_ai?schema=public"
# - Neon (cloud, miễn phí): dán chuỗi kết nối Neon, nhớ có ?sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT – chuỗi bí mật >= 64 ký tự. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-64-ky-tu-thay-bang-chuoi-ngau-nhien-it-nhat-64"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Server
NODE_ENV=development
PORT=5000

# Các domain được gọi API (cách nhau dấu phẩy). Bỏ trống = cho phép tất cả.
CORS_ORIGIN=
